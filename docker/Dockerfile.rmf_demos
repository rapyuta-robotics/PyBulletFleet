# docker/Dockerfile.rmf_demos
# Unified PyBulletFleet + ROS 2 bridge Docker image.
# Base: official Open-RMF demos image (includes rmf packages, maps, fleet adapter, etc.)
#
# Build:
#   cd docker && docker compose build
#
# Multi-stage layout:
#   Stage 1 (fuel-cache): Downloads Gazebo Fuel models (~80 models, ~20 min).
#     - Only invalidated when download_fuel_models.py itself changes.
#   Stage 2 (bridge):     Installs pybullet_fleet + ROS 2 bridge code.
#     - Invalidated on any pybullet_fleet/ or ros2_bridge/ change.
#     - Copies pre-downloaded Fuel models from stage 1 (instant).
#
# Result: code-only changes rebuild in ~5 min instead of ~25 min.


# The Open-RMF demos base image, pinned by digest. `jazzy-rmf-latest` is rebuilt
# nightly from upstream sources, and a rebuild can change what this image relies on:
# the build of 2026-10-18 writes the demo worlds' models as `model://<name>` instead
# of Fuel URLs, so download_fuel_models.py finds nothing to cache. To move to a newer
# build, take its digest (`docker buildx imagetools inspect <tag>`), check that the
# Fuel cache stage still finds the models, and update the value here and in the
# other Dockerfiles that use it.
ARG RMF_DEMOS_IMAGE=ghcr.io/open-rmf/rmf/rmf_demos:jazzy-rmf-latest@sha256:ddfb93f6f589319fcbb9e1bc8d1f2792dde41156e23fdf68e6fe8cdb8db23606

# ===========================================================================
# Stage 1: Fuel model cache (only rebuilds when download script changes)
# ===========================================================================
FROM ${RMF_DEMOS_IMAGE} AS fuel-cache

COPY docker/download_fuel_models.py /opt/download_fuel_models.py
RUN python3 /opt/download_fuel_models.py


# ===========================================================================
# Stage 2: Main bridge image
# ===========================================================================
FROM ${RMF_DEMOS_IMAGE} AS bridge

ENV DEBIAN_FRONTEND=noninteractive
ENV RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
SHELL ["/bin/bash", "-c"]

# Install additional deps not in rmf_demos image
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-tk \
    ros-jazzy-nav2-msgs \
    ros-jazzy-control-msgs \
    ros-jazzy-tf2-ros \
    ros-jazzy-tf2-geometry-msgs \
    ros-jazzy-trajectory-msgs \
    ros-jazzy-diagnostic-msgs \
    ros-jazzy-teleop-twist-keyboard \
    ros-jazzy-xacro \
    ros-jazzy-turtlebot3-description \
    ros-jazzy-ur-description \
    # OpenGL / Mesa for PyBullet GUI inside Docker
    libgl1-mesa-dri \
    libglx-mesa0 \
    libegl-mesa0 \
    libglvnd0 \
    libgl1 \
    libglx0 \
    libegl1 \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-downloaded Fuel models from stage 1 (instant, ~200 MB)
COPY --from=fuel-cache /root/.gz/fuel /root/.gz/fuel

# Install pybullet_fleet
COPY requirements.txt /opt/pybullet_fleet/requirements.txt
COPY pyproject.toml /opt/pybullet_fleet/pyproject.toml
# robots/, config/, mesh/ now live under pybullet_fleet/ (bundled package data),
# so they are copied with the package above — no separate COPY needed.
COPY pybullet_fleet/ /opt/pybullet_fleet/pybullet_fleet/
WORKDIR /opt/pybullet_fleet
# Keep numpy on the 1.x line that ROS 2 Jazzy and pybullet are built against. The
# RMF base ships numpy via apt (no pip RECORD, so pip can't uninstall it), and the
# [sdf] extras (trimesh/pycollada) would otherwise pull numpy 2.x — breaking the
# C-extensions ("compiled using NumPy 1.x cannot run in NumPy 2.x"). Re-seat a
# pip-managed numpy<2, then constrain every install in this stage to <2.
#
# Removal trigger: this pin tracks the Jazzy LTS runtime, not our own needs.
# Drop these two lines once the base image (open-rmf/rmf_demos) ships numpy 2.x
# — i.e. when adopting a post-Jazzy distro. Jazzy is LTS until 2029-05, so the
# pin stays until then. (core pybullet_fleet already works on numpy 2.x.)
RUN pip install --break-system-packages --ignore-installed "numpy<2" \
    && printf 'numpy<2\n' > /opt/pbf-constraints.txt
ENV PIP_CONSTRAINT=/opt/pbf-constraints.txt
# [sdf] extra pulls trimesh + pycollada so the SDF loader can extract <submesh>
# parts (e.g. the Caddy's polaris.dae) instead of loading overlapping full meshes.
RUN pip install --break-system-packages -e ".[sdf]"

# Build pybullet_fleet_msgs, pybullet_fleet_ros, and pybullet_fleet_rmf into the existing rmf_demos workspace
# (rmf_fleet_adapter_python and simulation_interfaces are already installed)
COPY ros2_bridge/pybullet_fleet_msgs /rmf_demos_ws/src/pybullet_fleet_msgs
COPY ros2_bridge/pybullet_fleet_ros /rmf_demos_ws/src/pybullet_fleet_ros
COPY ros2_bridge/pybullet_fleet_rmf /rmf_demos_ws/src/pybullet_fleet_rmf
WORKDIR /rmf_demos_ws
RUN source /opt/ros/jazzy/setup.bash && \
    source /rmf_demos_ws/install/setup.bash && \
    rm -rf \
      build/pybullet_fleet_msgs build/pybullet_fleet_ros build/pybullet_fleet_rmf \
      install/pybullet_fleet_msgs install/pybullet_fleet_ros install/pybullet_fleet_rmf && \
    colcon build --symlink-install \
    --packages-select pybullet_fleet_msgs pybullet_fleet_ros pybullet_fleet_rmf \
    --cmake-args -DCMAKE_BUILD_TYPE=Release

# Copy test and utility scripts
COPY docker/bridge_test_lib.sh /opt/pybullet_fleet/docker/bridge_test_lib.sh
COPY docker/ros_check_utils.py /opt/pybullet_fleet/docker/ros_check_utils.py
COPY docker/test_bridge_api.sh /opt/pybullet_fleet/docker/test_bridge_api.sh
COPY docker/bridge_api_check.py /opt/pybullet_fleet/docker/bridge_api_check.py
COPY docker/test_fleet_scale.sh /opt/pybullet_fleet/docker/test_fleet_scale.sh
COPY docker/fleet_scale_check.py /opt/pybullet_fleet/docker/fleet_scale_check.py
COPY docker/fleet_scale_config.py /opt/pybullet_fleet/docker/fleet_scale_config.py
RUN chmod +x \
    /opt/pybullet_fleet/docker/bridge_test_lib.sh \
    /opt/pybullet_fleet/docker/test_bridge_api.sh \
    /opt/pybullet_fleet/docker/test_fleet_scale.sh

# Keep download script in image for manual re-runs if needed
COPY docker/download_fuel_models.py /opt/pybullet_fleet/docker/download_fuel_models.py

# Entrypoint (same as rmf_demos: sources /opt/ros/jazzy + /rmf_demos_ws/install)
# Already set by base image's /ros_entrypoint.sh
WORKDIR /opt/pybullet_fleet
